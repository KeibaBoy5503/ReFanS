<Window x:Class="ReFanS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReFanS"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="ReFanS" Height="880" Width="1540"
        FontFamily="Pretendard, Inter, Segoe UI Variable Display, Yu Gothic UI, Malgun Gothic"
        Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseMove="Window_MouseMove">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Theme Colors-->
        <SolidColorBrush x:Key="ThemeCenterBg" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="ThemeSidebarBg" Color="#252526"/>
        <SolidColorBrush x:Key="ThemeCardBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#333337"/>
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#AAAAAA"/>

        <!-- Modern ScrollBar -->
        <Style x:Key="MinimalScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="#5A5A62" CornerRadius="3" Margin="0,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#8A8A95"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource MinimalScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- OnMouse ScrollBar -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0" Opacity="0" Cursor="Arrow" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportHeight}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Column="0" Grid.Row="1" Opacity="0" Cursor="Arrow" Maximum="{TemplateBinding ScrollableWidth}" Minimum="0" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" ViewportSize="{TemplateBinding ViewportWidth}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#222225" BorderBrush="#45454A" BorderThickness="1" CornerRadius="8" Padding="5">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid Background="Transparent">
                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SubArrow" Grid.Column="1" Text="▸" Foreground="#888888" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="2" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#222225" BorderBrush="#45454A" BorderThickness="1" CornerRadius="8" Padding="6">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E44"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnifiedTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="ItemRowBorder" Background="Transparent" CornerRadius="5" Padding="6,4.5" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Foreground="#999999" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <TextBlock x:Name="ArrowText" Text="▸" Foreground="#999999" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowText" Property="Text" Value="▾"/>
                                                        <Setter TargetName="ArrowText" Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger SourceName="ItemRowBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRowBorder" Property="Background" Value="#25888888"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRowBorder" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Upper UI Modulation -->
    <Grid Background="{DynamicResource ThemeCenterBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSidebarCol" Width="280" MinWidth="210"/>
            <ColumnDefinition x:Name="LeftSplitterCol" Width="5"/>
            <ColumnDefinition Width="*" MinWidth="450"/>
            <ColumnDefinition x:Name="RightSplitterCol" Width="0"/>
            <ColumnDefinition x:Name="RightDetailCol" Width="0" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- Skin Feature -->
        <Image x:Name="CustomBgWallpaperImage" Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="0"
               Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Remain Right Upper UI -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="999"
                    Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
            <Button Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="48" Height="34" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" FontSize="11" Cursor="Hand" Click="MinimizeWindow_Click" ToolTip="Minimize"/>
            <Button x:Name="MaxRestoreBtn" Content="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="48" Height="34" Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" FontSize="11" Cursor="Hand" Click="MaximizeRestoreWindow_Click" ToolTip="Maximize"/>
            <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="48" Height="34" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" FontSize="11" Cursor="Hand" Click="CloseWindow_Click" ToolTip="Close"/>
        </StackPanel>

        <!-- [Row 1] Left SideBar -->
        <Border x:Name="LeftSidebarBorder" Grid.Column="0" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,1,0" Padding="12,10,0,12">
            <Border.RenderTransform>
                <TranslateTransform x:Name="LeftDrawerTransform" X="0"/>
            </Border.RenderTransform>
            <DockPanel>
                <!-- Left Header, Captures, Icons, SidebarBtn -->
                <Grid DockPanel.Dock="Top" Margin="2,0,10,14" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnOpenSettingsLogo" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OpenSettings_Click" ToolTip="환경 설정 (Preferences)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="IconBtnBorder" Background="{DynamicResource ThemeCardBg}" CornerRadius="8" Padding="4" Width="34" Height="34">
                                    <Grid>
                                        <Image x:Name="AppLogoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock x:Name="AppLogoFallback" Text="💠" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBtnBorder" Property="Background" Value="#007ACC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="🖥️" Style="{StaticResource HeaderIconBtnStyle}" FontSize="13.5" Margin="0,0,4,0" Click="CaptureImmediateScreen_Click" ToolTip="전체화면캡쳐"/>
                        <Button Content="📷" Style="{StaticResource HeaderIconBtnStyle}" FontSize="13.5" Margin="0,0,4,0" Click="CaptureScreen_Click" ToolTip="최소화 후 전체화면 캡쳐"/>
                        <Button Content="✂️" Style="{StaticResource HeaderIconBtnStyle}" FontSize="13.5" Margin="0,0,4,0" Click="CaptureRegionScreen_Click" ToolTip="영역 지정 드래그 캡처"/>
                        <Button Content="◧" Style="{StaticResource HeaderIconBtnStyle}" FontSize="14" Click="ToggleLeftSidebar_Click" ToolTip="좌측 사이드바 접기"/>
                    </StackPanel>
                </Grid>

                <!-- LeftScrollview -->
                <ScrollViewer x:Name="LeftSidebarScrollViewer" 
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="LeftSidebar_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="LeftSidebar_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="LeftSidebar_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="LeftSidebar_PreviewMouseLeftButtonUp">
                    <StackPanel Margin="0,0,10,0">
                        <!-- 1. LIBRARY -->
                        <TextBlock x:Name="LblLibraryHeader" Text="LIBRARY" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="Bold" Margin="6,2,6,6"/>
                        <ListBox x:Name="SmartFolderList" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" AllowDrop="True"
                                 PreviewMouseWheel="BubbleMouseWheelToParent"
                                 PreviewMouseLeftButtonDown="LibraryItem_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="LibraryItem_PreviewMouseMove"
                                 Drop="LibraryItem_Drop"
                                 SelectionChanged="SmartFolderList_SelectionChanged" Margin="0,0,0,18">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,4.5"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="LibItemBorder" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter TextElement.Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="LibItemBorder" Property="Background" Value="#25888888"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="LibItemBorder" Property="Background" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 2. FOLDERS  -->
                        <Grid Margin="6,0,4,6">
                            <TextBlock x:Name="LblFoldersHeader" Text="FOLDERS" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button x:Name="BtnAddFolder" Content="+ 폴더" HorizontalAlignment="Right" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="11" Padding="8,3" Cursor="Hand" Click="AddRootFolder_Click"/>
                        </Grid>

                        <TreeView x:Name="UserFolderTree" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}"
                                  ItemContainerStyle="{StaticResource UnifiedTreeViewItemStyle}" AllowDrop="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="BubbleMouseWheelToParent"
                                  PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FolderTree_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="FolderTree_PreviewMouseLeftButtonUp"
                                  SelectedItemChanged="UserFolderTree_SelectedItemChanged"
                                  PreviewMouseRightButtonDown="UserFolderTree_PreviewMouseRightButtonDown" Margin="0,0,0,18">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📁 하위 폴더 추가" Click="AddSubFolder_Click"/>
                                    <MenuItem Header="📤 최상위 폴더로 빼기 (밖으로 이동)" Click="MoveFolderToRoot_Click"/>
                                    <MenuItem Header="✨ 폴더 아이콘(이모지/이미지) 변경">
                                        <MenuItem.Items>
                                            <StackPanel Width="290" Margin="2">
                                                <Button Content="🖼️ + Custom Icon (100x100)" 
                                                        Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="11"
                                                        Padding="8,6" Margin="0,0,0,8" BorderThickness="0" Cursor="Hand"
                                                        Click="AddCustomEmojiImage_Click"/>
                                                <ScrollViewer Height="185" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="EmojiPickerGrid">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="10"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding}" Width="26" Height="26" Margin="1"
                                                                        FontSize="13.5" Background="#2D2D32" Foreground="White"
                                                                        BorderThickness="0" Cursor="Hand"
                                                                        Click="EmojiButton_Click"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </MenuItem.Items>
                                    </MenuItem>
                                    <MenuItem Header="🎨 폴더 아이콘 색상 변경 (100색 + RGB)" Click="OpenColorPickerForFolderIcon_Click"/>
                                    <MenuItem Header="🖍️ 폴더 이름(글자) 색상 변경 (100색 + RGB)" Click="OpenColorPickerForFolderName_Click"/>
                                    <MenuItem Header="✏️ 폴더 이름 변경" Click="RenameFolder_Click"/>
                                    <Separator Background="#444444"/>
                                    <MenuItem Header="🔒 폴더 잠금 / 잠금 해제" Click="ToggleFolderLock_Click"/>
                                    <MenuItem Header="🗑️ 폴더 삭제" Click="DeleteFolder_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding SubFolders}">
                                    <StackPanel Orientation="Horizontal" Background="Transparent" AllowDrop="True" Drop="FolderItemPanel_Drop">
                                        <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomImageIcon}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border CornerRadius="3" ClipToBounds="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomImageIcon}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LockBadge}" Foreground="#FFB3BA" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- 3. TAGS & FILTER -->
                        <Grid Margin="6,0,4,6">
                            <TextBlock x:Name="LblTagsHeader" Text="TAGS &amp; FILTER" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnAddFilterGroup" Content="+ 그룹" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="10.5" Padding="6,3" Margin="0,0,4,0" Cursor="Hand" Click="AddCustomFilterGroup_Click"/>
                                <Button x:Name="BtnManageTags" Content="⚙️ 관리" Background="{DynamicResource ThemeCardBg}" Foreground="#569CD6" FontWeight="Bold" BorderThickness="0" FontSize="10.5" Padding="6,3" Cursor="Hand" Click="OpenTagManager_Click"/>
                            </StackPanel>
                        </Grid>

                        <TreeView x:Name="FilterTreeView" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}"
                                  ItemContainerStyle="{StaticResource UnifiedTreeViewItemStyle}" AllowDrop="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="BubbleMouseWheelToParent"
                                  PreviewMouseLeftButtonDown="FilterTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="FilterTree_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="TreeDrag_PreviewMouseLeftButtonUp"
                                  PreviewMouseRightButtonDown="FilterTreeView_PreviewMouseRightButtonDown"
                                  MouseDoubleClick="FilterTreeView_MouseDoubleClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🏷️ 새 태그 / 하위 태그 추가" Click="AddTagFromTree_Click"/>
                                    <MenuItem Header="✏️ 이름 변경 (일괄 반영)" Click="RenameTagFromTree_Click"/>
                                    <MenuItem Header="🎨 태그/필터 배경 색상 변경 (100색 + RGB)" Click="OpenColorPickerForFilterNode_Click"/>
                                    <MenuItem Header="🖍️ 필터 제목(글자) 색상 변경 (100색 + RGB)" Click="OpenColorPickerForFilterHeader_Click"/>
                                    <Separator Background="#444444"/>
                                    <MenuItem Header="🗑️ 이 태그/그룹 삭제" Click="DeleteTagFromTree_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding SubNodes}">
                                    <Grid AllowDrop="True" Drop="FilterTreeItem_Drop">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{Binding NameColor}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Foreground="#888888" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <WrapPanel Orientation="Horizontal" MaxWidth="195">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <Border Background="{Binding HexColor}" CornerRadius="4" Padding="7,2.5" Margin="0,0,5,0" MaxWidth="160" BorderBrush="#44000000" BorderThickness="1">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#1E1E1E" FontSize="11.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" Background="Transparent" HorizontalAlignment="Center" Cursor="SizeWE"/>

        <!-- [Row 2] Middle View Area -->
        <Grid Grid.Column="2" Margin="0,34,0,0">
            <!-- (1) Basic Gallery View -->
            <DockPanel x:Name="GalleryContainer" Margin="15,4,0,10">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,15,10" Margin="0,0,0,10" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="HeaderExpandLeftBtn" Grid.Column="0" Content="◧" Visibility="Collapsed" Style="{StaticResource HeaderIconBtnStyle}" Margin="0,0,8,0" Click="ToggleLeftSidebar_Click" ToolTip="좌측 사이드바 펴기"/>

                        <!-- Search Bar -->
                        <Border Grid.Column="1" Background="{DynamicResource ThemeCardBg}" CornerRadius="6" Height="34">
                            <Grid>
                                <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" 
                                         Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                                         LostFocus="SearchBox_LostFocus"/>
                                <TextBlock x:Name="LblSearchPlaceholder" Text="🔍 검색" Foreground="#888888" FontSize="12.5" 
                                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Sort Menu -->
                        <Button x:Name="SortMenuBtn" Grid.Column="2" Height="34" Padding="12,0" Margin="8,0,0,0"
                                Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                Cursor="Hand" Click="SortMenuBtn_Click" ToolTip="정렬 방식 변경">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⇅ " Foreground="#569CD6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CurrentSortText" Text="수동 정렬" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" ▾" Foreground="#888888" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuSort0" Header="✋  수동 정렬 (기본 순서)" Tag="0" Click="SortOption_Click"/>
                                    <MenuItem x:Name="MenuSort1" Header="📅  날짜/시간순 (최신 등록순)" Tag="1" Click="SortOption_Click"/>
                                    <MenuItem x:Name="MenuSort2" Header="🔤  이름순 (가나다 / ABC)" Tag="2" Click="SortOption_Click"/>
                                    <MenuItem x:Name="MenuSort3" Header="📦  확장자 및 파일 유형별" Tag="3" Click="SortOption_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button x:Name="ViewModeBtn" Grid.Column="3" Content="🖼️ 이미지 보드" Height="34" Padding="11,0" Margin="6,0,0,0"
                                Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ToggleViewMode_Click" ToolTip="뷰 모드 전환"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                            <TextBlock Text="🔍" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Slider x:Name="CardSizeSlider" Width="65" Minimum="140" Maximum="380" Value="210" ToolTip="카드 크기 조절"/>
                        </StackPanel>

                        <Button x:Name="AddMenuBtn" Grid.Column="5" Height="34" Padding="14,0"
                                Background="#007ACC" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="AddMenuBtn_Click" ToolTip="새 레퍼런스 추가">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddBtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="LblAddBtn" Text="+ 추가" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Text=" ▾" Foreground="#D0E8FF" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📂  파일 업로드 (탐색기 열기)" Click="UploadFilesMenu_Click"/>
                                    <MenuItem Header="🌐  웹 URL / YouTube / SNS 링크 추가" Click="AddUrlReference_Click"/>
                                    <Separator Background="#444444"/>
                                    <MenuItem Header="🎵  큐레이션 카드 추가" Click="AddButton_Click"/>
                                    <MenuItem Header="📄  새 문서 (.txt / .md) 추가" Click="AddTextNote_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button x:Name="BtnHeaderToggleRight" Grid.Column="6" Content="◨" Style="{StaticResource HeaderIconBtnStyle}" Width="34" Height="34" Margin="6,0,0,0" Click="ToggleRightSidebar_Click" ToolTip="우측 인스펙터 사이드바 열기 / 닫기"/>

                        <!-- Search Filter -->
                        <Popup x:Name="SearchFilterPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border x:Name="SearchFilterPopupBorder" Background="#222226" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="10" Padding="18,16" Width="320"
                                    MouseEnter="SearchFilterPopup_MouseEnter" MouseLeave="SearchFilterPopup_MouseLeave">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="🎯 상세 검색 필터" Foreground="#569CD6" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#888888" BorderThickness="0" FontSize="13" Cursor="Hand" Click="CloseSearchAssist_Click"/>
                                    </Grid>
                                    <Separator Background="#333337" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkSearchCurrentFolder" Content="📁 현재 선택된 폴더 내 검색" Foreground="White" FontSize="13.5" Margin="0,0,0,10" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                    <CheckBox x:Name="ChkSearchTitleCreator" Content="🔤 제목 / 작곡가 / 작품명" IsChecked="True" Foreground="#DDDDDD" FontSize="13.5" Margin="0,0,0,10" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                    <CheckBox x:Name="ChkSearchTags" Content="🏷️ 태그 (Tags)" IsChecked="True" Foreground="#DDDDDD" FontSize="13.5" Margin="0,0,0,10" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                    <CheckBox x:Name="ChkSearchFileType" Content="📦 파일 종류 / 확장자" IsChecked="True" Foreground="#DDDDDD" FontSize="13.5" Margin="0,0,0,10" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                    <CheckBox x:Name="ChkSearchDate" Content="📅 생성일 (yyyy-MM-dd)" IsChecked="True" Foreground="#DDDDDD" FontSize="13.5" Margin="0,0,0,10" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                    <Separator Background="#333337" Margin="0,2,0,10"/>
                                    <CheckBox x:Name="ChkSearchDocTextOnly" Content="📄 문서 본문(.txt/.md)만 검색" Foreground="#FFB3BA" FontSize="13.5" FontWeight="SemiBold" Checked="SearchFilterCheck_Changed" Unchecked="SearchFilterCheck_Changed"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 10x10 Color Picker -->
                        <Popup x:Name="UniversalColorPickerPopup" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="#1E1E22" BorderBrush="#569CD6" BorderThickness="1.5" CornerRadius="10" Padding="12" Width="310">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="LblPalettePopupTitle" Text="🎨 100색 팔레트 (기본 / 파스텔 / 그레이톤)" Foreground="#E0E0E0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Content="🌈 RGB" HorizontalAlignment="Right" Background="#3E3E42" Foreground="White" BorderThickness="0" FontSize="10" Padding="7,3" Cursor="Hand" Click="TogglePopupRgbMap_Click"/>
                                    </Grid>
                                    <ItemsControl x:Name="Universal100ColorGrid" Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="10" Rows="10"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding}" Width="25" Height="22" CornerRadius="3" Margin="1.5" Cursor="Hand"
                                                        BorderBrush="#33FFFFFF" BorderThickness="1" MouseLeftButtonUp="UniversalColorChip_Click" ToolTip="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border x:Name="PopupRgbMapBorder" Visibility="Collapsed" Background="#141416" CornerRadius="6" Padding="8" Margin="0,4,0,0" BorderBrush="#444444" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="마우스로 드래그하여 미세 RGB 색상을 추출하세요" Foreground="#AAAAAA" FontSize="9.5" Margin="0,0,0,4"/>
                                            <Border CornerRadius="4" ClipToBounds="True" Height="115" Cursor="Cross" BorderBrush="#555555" BorderThickness="1"
                                                    MouseLeftButtonDown="RgbSpectrumMap_MouseDownOrMove" MouseMove="RgbSpectrumMap_MouseDownOrMove">
                                                <Image x:Name="RgbSpectrumImage" Stretch="Fill"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Ghost Drag Box -->
                        <Popup x:Name="TreeDragGhostPopup" IsHitTestVisible="False" Placement="RelativePoint" AllowsTransparency="True">
                            <Border Background="#DD007ACC" BorderBrush="#88FFFFFF" BorderThickness="1.5" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="TreeDragGhostText" Text="📁 폴더 이동 중..." Foreground="White" FontSize="12.5" FontWeight="Bold"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Mouse Drag Selection & Ctrl+mouse/Ctrl+A Multi Selection -->
                <Grid x:Name="GalleryViewportGrid">
                    <ListBox x:Name="GalleryList" Background="Transparent" BorderThickness="0" 
                             SelectionMode="Extended" AllowDrop="True"
                             HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             ScrollViewer.CanContentScroll="False"
                             SelectionChanged="GalleryList_SelectionChanged"
                             PreviewMouseWheel="GalleryList_PreviewMouseWheel"
                             PreviewMouseLeftButtonDown="GalleryList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="GalleryList_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="GalleryList_PreviewMouseLeftButtonUp"
                             Drop="GalleryList_Drop"
                             MouseDoubleClick="GalleryList_MouseDoubleClick">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="CardWrapper" CornerRadius="8" Margin="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="CardWrapper" Property="Background" Value="#2A007ACC"/>
                                                    <Setter TargetName="CardWrapper" Property="BorderBrush" Value="#007ACC"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardWrapper" Property="Background" Value="#14888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:MasonryPanel ColumnWidth="{Binding ElementName=CardSizeSlider, Path=Value}"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardItemBorder" Padding="6" Cursor="Hand" Background="Transparent" ToolTip="더블클릭/Space: 확대 | Ctrl+클릭/빈공간 드래그: 다중 선택 | 카드 드래그: 폴더 이동">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ThemeCardBg}">
                                                <Image Source="{Binding ThumbnailSource}" RenderOptions.BitmapScalingMode="LowQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Stretch" Value="UniformToFill"/>
                                                            <Setter Property="Height" Value="180"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag, ElementName=ViewModeBtn}" Value="ImageBoard">
                                                                    <Setter Property="Stretch" Value="Uniform"/>
                                                                    <Setter Property="Height" Value="NaN"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Border>

                                            <!-- Inline Video Layer, ( 1.2.3 changed ThumnailSource ) -->
                                            <Border CornerRadius="6" ClipToBounds="True" Background="Black" MinHeight="160">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInlinePlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" Opacity="0.35"/>
                                                    <MediaElement LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                                                  ScrubbingEnabled="True" Loaded="InlineCardMedia_Loaded"/>
                                                </Grid>
                                            </Border>

                                            <Border CornerRadius="6" Background="{DynamicResource ThemeCardBg}" Padding="12" MinHeight="140">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Text">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="📄 DOCUMENT / MARKDOWN" Foreground="#569CD6" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{Binding TextContent}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" TextWrapping="Wrap" MaxHeight="140" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <Border CornerRadius="6" Background="{DynamicResource ThemeCardBg}" Padding="14" MinHeight="160">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ItemType}" Value="Font">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Aa 가나다" FontFamily="{Binding CustomFontFamily}" FontSize="34" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,6,0,6" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FontSampleText}" FontFamily="{Binding CustomFontFamily}" FontSize="13" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bookmark, Lock -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                <TextBlock Text="⭐" FontSize="13" Margin="0,0,4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="🔒" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Media only mini play bar section -->
                                            <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="6,0,42,6" Background="#D8141418" CornerRadius="6" Padding="4,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsPlayableMedia}" Value="True"/>
                                                                    <Condition Binding="{Binding IsMouseOver, ElementName=CardItemBorder}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsPlayableMedia}" Value="True"/>
                                                                    <Condition Binding="{Binding IsInlinePlaying}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="{Binding InlinePlayButtonIcon}" Width="24" Height="22" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="10" BorderThickness="0" Cursor="Hand"
                                                            Click="CardMiniPlay_Click"/>
                                                    <ProgressBar Grid.Column="1" Value="{Binding InlineProgress}" Minimum="0" Maximum="100" Height="6" Margin="6,0" VerticalAlignment="Center"
                                                                 Background="#33FFFFFF" Foreground="#007ACC" BorderThickness="0" Cursor="Hand"
                                                                 MouseLeftButtonDown="CardInlineProgressBar_MouseDown"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding InlineTimeText}" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- Preview button -->
                                            <Border Background="#CC007ACC" CornerRadius="6" Width="30" Height="30" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                    MouseEnter="Magnifier_MouseEnter" MouseLeave="Magnifier_MouseLeave">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardItemBorder}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="🔍" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource ThemeTextPrimary}" Margin="2,2,2,3" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="2,0,2,4">
                                            <Border Background="{DynamicResource ThemeCardBg}" CornerRadius="3" Padding="5,1.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeBadgeText}" Foreground="#569CD6" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Composer}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, ElementName=ViewModeBtn}" Value="ImageBoard">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="{Binding GameTitle}" Foreground="#888888" FontSize="10.5" Margin="2,0,2,5" TextTrimming="CharacterEllipsis"/>
                                            <ItemsControl ItemsSource="{Binding Labels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding HexColor}" CornerRadius="3" Padding="5,1.5" Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding Name}" Foreground="#1E1E1E" FontSize="9.5" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Marquee Lasso Box -->
                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="SelectionLassoBox" Visibility="Collapsed" Background="#33007ACC" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="2"/>
                    </Canvas>

                    <!-- Media Mini Player & Progress Bar -->
                    <Border x:Name="MiniPreviewPlayerBar" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                            Width="460" Background="#F01E1E24" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="10" Padding="12,10" Panel.ZIndex="90">
                        <StackPanel>
                            <!-- Movie -->
                            <Border x:Name="MiniVideoContainer" Visibility="Collapsed" Height="190" CornerRadius="6" ClipToBounds="True" Background="Black" Margin="0,0,0,8">
                                <MediaElement x:Name="MiniPreviewMediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                              ScrubbingEnabled="True" MediaOpened="MiniPreviewMedia_Opened" MediaEnded="MiniPreviewMedia_Ended"/>
                            </Border>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="MiniPreviewTitleText" Text="Playing..." Foreground="White" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,30,0"/>
                                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="12" Cursor="Hand" Click="CloseMiniPreview_Click"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MiniPlayPauseBtn" Grid.Column="0" Content="⏸" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="24" Cursor="Hand" Click="MiniPlayPause_Click"/>
                                <Slider x:Name="MiniPreviewSeekSlider" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Cursor="Hand"
                                        PreviewMouseLeftButtonUp="MiniPreviewSeek_MouseUp"/>
                                <TextBlock x:Name="MiniPreviewTimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- (2) LightboxView -->
            <Border x:Name="LightboxView" Visibility="Collapsed" Opacity="0" Background="{DynamicResource ThemeCenterBg}" Padding="20,40,20,20" 
                    RenderTransformOrigin="0.5,0.5" MouseDown="LightboxBackground_MouseDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LightboxPopupScale" ScaleX="0.94" ScaleY="0.94"/>
                </Border.RenderTransform>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSidebarBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="← 갤러리 복귀 (ESC)" Padding="14,6" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseLightbox_Click"/>
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                <TextBlock Text="{Binding Resolution}" FontSize="12" Foreground="#569CD6" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🚀 외부 프로그램 열기" Padding="12,6" Margin="0,0,8,0" Background="#2D5A27" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="OpenExternalFile_Click"/>
                                <Button Content="📝 전체 화면 집중 편집 모드 (Space)" Padding="14,6" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="OpenFullEditFromLightbox_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="LightboxMediaBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="#1F1F23" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" BorderBrush="#333337" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="LightboxPlayBtn" Grid.Column="0" Content="⏸" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="28" Cursor="Hand" Click="LightboxPlayPause_Click"/>
                            <Slider x:Name="LightboxSeekSlider" Grid.Column="1" VerticalAlignment="Center" Margin="14,0" Minimum="0" Maximum="100"
                                    IsMoveToPointEnabled="True" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="LightboxSeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="LightboxSeekSlider_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="LightboxSeekSlider_PreviewMouseLeftButtonUp"
                                    ValueChanged="LightboxSeekSlider_ValueChanged"/>
                            <TextBlock x:Name="LightboxTimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Background="#181818" CornerRadius="10" ClipToBounds="True" PreviewMouseWheel="LightboxImage_PreviewMouseWheel">
                        <Grid>
                            <Image x:Name="LightboxImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="LightboxScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Image.RenderTransform>
                            </Image>
                            <MediaElement x:Name="LightboxMediaPlayer" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform"
                                          ScrubbingEnabled="True" MouseLeftButtonDown="LightboxPlayPause_Click"
                                          MediaOpened="LightboxMediaPlayer_MediaOpened" MediaEnded="LightboxMediaPlayer_MediaEnded"/>
                            <Border x:Name="LightboxTextReader" Visibility="Collapsed" Background="{DynamicResource ThemeSidebarBg}" Padding="35" CornerRadius="8">
                                <FlowDocumentScrollViewer x:Name="MarkdownDocViewer" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
                            </Border>
                            <wv2:WebView2 x:Name="LightboxPdfWebView" Visibility="Collapsed" DefaultBackgroundColor="#181818"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- (3) edit mode workplace -->
            <Border x:Name="FocusEditView" Visibility="Collapsed" Opacity="0" Background="{DynamicResource ThemeCenterBg}" Padding="25,40,25,25" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="FocusViewScale" ScaleX="0.96" ScaleY="0.96"/>
                </Border.RenderTransform>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeSidebarBg}" CornerRadius="8" Padding="15,10" Margin="0,0,0,20" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="← 갤러리로 돌아가기 (ESC)" Padding="14,6" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseFocusMode_Click"/>
                                <TextBlock Text="집중 편집 워크스페이스" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🚀 외부 실행" Padding="12,6" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="OpenExternalFile_Click"/>
                                <Button Content="🖼️ 이미지 변경" Padding="12,6" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="ChangeImageButton_Click"/>
                                <Button Content="💾 저장" Padding="12,6" Background="#2D5A27" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="SaveDb_Click"/>
                                <Button Content="🗑️ 삭제" Padding="12,6" Background="{DynamicResource ThemeCardBg}" Foreground="#FF6B6B" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="DeleteItem_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Height="360" CornerRadius="10" Background="{DynamicResource ThemeSidebarBg}" ClipToBounds="True" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding CoverImagePath}" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,10,0,15">
                                    <TextBlock Text="{Binding Resolution}" Foreground="#569CD6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="📋 원본 이미지 복사" HorizontalAlignment="Right" Padding="10,5" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Click="CopyImageToClipboard_Click"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ColorPalette}" Margin="0,0,0,20">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding}" Height="34" CornerRadius="5" Margin="0,0,6,0" Cursor="Hand" BorderBrush="#444444" BorderThickness="1" MouseLeftButtonUp="ColorSwatch_Click" ToolTip="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="TITLE" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="12,10" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="🎼 COMPOSER" Foreground="#569CD6" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="10,8" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="🎤 ARTIST / CREATOR" Foreground="#888888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="10,8" FontSize="14"/>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,15">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="🎮 GAME / WORK TITLE" Foreground="#888888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding GameTitle, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="10,8" FontSize="14"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="🏢 COMPANY / LABEL" Foreground="#888888" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="10,8" FontSize="14"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="DESCRIPTION &amp; CURATION NOTE" Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="12" MinHeight="120" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                                <TextBlock Text="📄 DOCUMENT / MARKDOWN EDITOR (.txt / .md)" Foreground="#569CD6" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Padding="14" MinHeight="260" FontSize="13.5" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- (4) Inpage Settings -->
            <Border x:Name="InPageSettingsView" Visibility="Collapsed" Opacity="0" Background="{DynamicResource ThemeCenterBg}" Padding="35,40,35,30" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsViewScale" ScaleX="0.96" ScaleY="0.96"/>
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBackFromSettings" Content="← 갤러리로 돌아가기 (ESC)" Padding="14,7" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="CloseSettings_Click"/>
                                <TextBlock x:Name="LblSettingsTitle" Text="⚙️ 환경 설정 (Preferences)" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="LblLangSection" Text="🌐 언어 설정 (Language)" Foreground="#569CD6" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3" Height="38">
                                    <Button Content="🇯🇵 日本語 (Japanese)" Margin="0,0,6,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SetLangJa_Click"/>
                                    <Button Content="🇰🇷 한국어 (Korean)" Margin="3,0,3,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SetLangKo_Click"/>
                                    <Button Content="🇺🇸 English" Margin="6,0,0,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="SetLangEn_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="LblThemeSection" Text="🎨 스킨 및 외관 테마 (Appearance Theme)" Foreground="#569CD6" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <UniformGrid Columns="4" Height="42">
                                    <Button Content="🌑 Default Dark" Margin="0,0,5,0" Background="#1E1E1E" Foreground="White" FontWeight="Bold" BorderBrush="#444444" BorderThickness="1" Cursor="Hand" Click="ApplyDefaultDarkTheme_Click"/>
                                    <Button Content="🌫️ Gray Tone" Margin="5,0,5,0" Background="#323337" Foreground="White" FontWeight="Bold" BorderBrush="#569CD6" BorderThickness="1" Cursor="Hand" Click="ApplyEagleGrayTheme_Click"/>
                                    <Button Content="☀️ Pure White" Margin="5,0,5,0" Background="#F5F6F8" Foreground="#1E1E1E" FontWeight="Bold" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="ApplyWhiteTheme_Click"/>
                                    <Button Content="🔮 Pastel Purple" Margin="5,0,0,0" Background="#2B2638" Foreground="#F2E6FF" FontWeight="Bold" BorderBrush="#B39DDB" BorderThickness="1" Cursor="Hand" Click="ApplyPastelPurpleTheme_Click"/>
                                </UniformGrid>
                                <Separator Background="{DynamicResource ThemeBorderBrush}" Margin="0,12,0,10"/>
                                <TextBlock Text="✨ CUSTOM COLOR &amp; BACKGROUND WALLPAPER " Foreground="#569CD6" FontSize="11.5" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnCustomThemeColor" Grid.Column="0" Content="🎨 커스텀 테마 색상 선택" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="PickCustomThemeTone_Click"/>
                                    <Button x:Name="BtnCustomBgImage" Grid.Column="1" Content="🖼️ 배경 사진 선택" Padding="12,6" Margin="0,0,6,0" Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="SelectCustomWallpaper_Click"/>
                                    <Button x:Name="BtnClearBgImage" Grid.Column="2" Content="초기화" Padding="10,6" Margin="0,0,12,0" Background="{DynamicResource ThemeCardBg}" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand" Click="ClearCustomWallpaper_Click"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="투명도:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Slider x:Name="WallpaperOpacitySlider" Width="110" Minimum="0.03" Maximum="0.65" Value="0.18" VerticalAlignment="Center" ValueChanged="WallpaperOpacitySlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="LblStorageSection" Text="📂 데이터 저장 폴더 (Workspace Directory) &amp; ☁️ Google Drive 연동" Foreground="#569CD6" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorkspaceDirTextBox" Grid.Column="0" IsReadOnly="True" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="10,8" FontSize="12"/>
                                    <Button x:Name="BtnChangeDir" Grid.Column="1" Content="📁 폴더 변경" Margin="6,0,0,0" Padding="14,8" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ChangeWorkspaceDirectory_Click"/>
                                    <Button x:Name="BtnOpenDir" Grid.Column="2" Content="탐색기 열기" Margin="6,0,0,0" Padding="12,8" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Click="OpenWorkspaceDirectory_Click"/>
                                </Grid>

                                <UniformGrid Columns="3" Height="36">
                                    <Button x:Name="BtnDriveUploadAll" Content="☁️ 전체 폴더 Google Drive 업로드" Margin="0,0,4,0" Background="#2D5A27" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="11.5" Cursor="Hand" Click="UploadAllToGoogleDrive_Click"/>
                                    <Button x:Name="BtnDriveUploadSel" Content="📁 선택 폴더만 Drive 업로드" Margin="4,0,4,0" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="11.5" Cursor="Hand" Click="UploadSelectedFolderToGoogleDrive_Click"/>
                                    <Button x:Name="BtnDriveExportZip" Content="🌐 ZIP 추출 &amp; 웹 드라이브 열기" Margin="4,0,0,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="Bold" BorderThickness="0" FontSize="11.5" Cursor="Hand" Click="ExportZipAndOpenGoogleDriveWeb_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- 4. Info ( Version, Credits ) -->
                        <Border Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="LblInfoSection" Text="ℹ️ Program Info &amp; Shortcuts" Foreground="#569CD6" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="ReFanS v1.2.3 " Foreground="{DynamicResource ThemeTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Background="#1A2634" BorderBrush="#2D4A68" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Created by KeibaBoy5503" Foreground="#569CD6" FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="• Space / Double-Click : Open Lightbox Preview (Press Space again for Focus Editor)&#x0a;• Drag Empty Space : Multi-Select Lasso (Ctrl + Click: Toggle, Ctrl + A: Select All)&#x0a;• Alt + Left Drag : Smooth Canvas Panning (Ctrl + Mouse Wheel: Zoom In/Out)&#x0a;• Drag Left Sidebar Items : Real-time Reordering for Library, Folders, and Filters&#x0a;• Supported Formats : Music, Audio (WAV/MP3 Waveform), Video (MP4), GIF, Image, Font, PDF, Markdown (.md), 3D, Design"
                                           Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" LineHeight="21" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Hover Preview -->
            <Border x:Name="HoverPreviewOverlay" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                    Background="#F2181818" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680" MaxHeight="680" Padding="14"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="HoverPreviewScale" ScaleX="0.92" ScaleY="0.92"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Border CornerRadius="8" ClipToBounds="True" MaxHeight="560" Background="#111111">
                        <Image x:Name="HoverPreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <Grid Margin="4,10,4,0">
                        <TextBlock x:Name="HoverPreviewTitle" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="HoverPreviewSub" Foreground="#569CD6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" Visibility="Collapsed" Background="Transparent" HorizontalAlignment="Center" Cursor="SizeWE"/>

        <!-- [Row 3] Right Side Panel -->
