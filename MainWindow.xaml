                Background="{DynamicResource ThemeSidebarBg}" Padding="18,38,18,18" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,0,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RightDrawerTransform" X="0"/>
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel">
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblInspectorHeader" Text="QUICK INSPECTOR" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11.5" FontWeight="Bold"/>
                            <TextBlock x:Name="MultiSelectCountText" Text="" Foreground="#569CD6" FontSize="11.5" FontWeight="Bold" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding BookmarkIcon}" Background="{DynamicResource ThemeCardBg}" Foreground="#FFD700" BorderThickness="0" Width="28" Height="26" Margin="0,0,4,0" Cursor="Hand" Click="ToggleBookmarkItem_Click" ToolTip="북마크 보관함에 추가 / 해제"/>
                            <Button Content="{Binding LockIcon}" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Width="28" Height="26" Margin="0,0,6,0" Cursor="Hand" Click="ToggleLockItem_Click" ToolTip="파일 잠금 (수정 및 삭제 방지)"/>
                            <Button x:Name="MoreToolsBtn" Content="⋯ 특수기능" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" Click="MoreToolsBtn_Click" ToolTip="특수 기능 메뉴">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuToolFullEdit" Header="📝 중앙 큰 편집 워크스페이스 열기" Click="OpenFullEditFromLightbox_Click"/>
                                        <MenuItem x:Name="MenuToolExec" Header="🚀 연결된 원본 파일/프로그램 실행" Click="OpenExternalFile_Click"/>
                                        <MenuItem x:Name="MenuToolExplorer" Header="📂 탐색기에서 원본 파일 위치 열기" Click="RevealInExplorer_Click"/>
                                        <Separator Background="#444444"/>
                                        <MenuItem x:Name="MenuToolApple" Header="⚡ 애플뮤직 자켓 검색창 열기/닫기" Click="ToggleAppleMusicPanel_Click"/>
                                        <MenuItem x:Name="MenuToolRescanFont" Header="🔍 문서(.pdf/.psd) 사용 폰트 강제 재스캔" Click="RescanDocumentFonts_Click"/>
                                        <Separator Background="#444444"/>
                                        <MenuItem x:Name="MenuToolSnsImg" Header="📸 SNS 카드 이미지(PNG) 렌더링" Click="ExportSnsImage_Click"/>
                                        <MenuItem x:Name="MenuToolSnsTxt" Header="📋 SNS 해시태그 템플릿 복사" Click="CopySnsTemplate_Click"/>
                                        <MenuItem x:Name="MenuToolJson" Header="📤 단일 JSON 파일 추출" Click="ExportTool_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="🗑️" Background="Transparent" Foreground="#FF6B6B" BorderThickness="0" Cursor="Hand" Click="DeleteItem_Click"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MultiFolderDisplay}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A2634" BorderBrush="#2D4A68" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,4">
                            <TextBlock Text="{Binding TypeBadgeText}" Foreground="#569CD6" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,4">
                            <TextBlock Text="{Binding CreatedAt, StringFormat='🕒 {0:yyyy.MM.dd HH:mm}'}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>

                    <Border Height="160" CornerRadius="6" Background="{DynamicResource ThemeCenterBg}" Margin="0,0,0,6" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="DetailImage" Source="{Binding CoverImagePath}" Stretch="Uniform"/>
                            <MediaElement x:Name="SharedMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="SharedMediaPlayer_MediaOpened" MediaEnded="SharedMediaPlayer_MediaEnded"/>
                        </Grid>
                    </Border>

                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{Binding CreatedAt, StringFormat='Added: {0:yyyy-MM-dd HH:mm}'}" Foreground="#888888" FontSize="10" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Resolution}" Foreground="#569CD6" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Background="{DynamicResource ThemeCenterBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#569CD6" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Font">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="🔤 LIVE FONT TESTER" Foreground="#569CD6" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding FontSampleText, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource ThemeSidebarBg}" CornerRadius="4" Padding="10">
                                <TextBlock Text="{Binding FontSampleText}" FontFamily="{Binding CustomFontFamily}" FontSize="22" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DetectedFontsPanel" Background="{DynamicResource ThemeCenterBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#4A3B5C" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Document">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Design">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="🔍 문서 내 사용된 폰트 (클릭 시 복사)" Foreground="#CE9178" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="재스캔" HorizontalAlignment="Right" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="9" Padding="5,2" Click="RescanDocumentFonts_Click"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DetectedFonts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="#569CD6" BorderThickness="1" CornerRadius="4" Padding="6,2.5" Margin="0,0,4,4" Cursor="Hand" MouseLeftButtonUp="DetectedFontChip_Click">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="10.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MediaPlayerPanel" Background="#1A1A1C" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" BorderBrush="#333337" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Music">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Video">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="🎧 AUDIO WAVEFORM &amp; SCRUBBER" Foreground="#569CD6" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📂 파일 연결" Background="#2D2D30" Foreground="#CCCCCC" BorderThickness="0" FontSize="9.5" Padding="6,2" Margin="0,0,4,0" Cursor="Hand" Click="AttachMediaFile_Click"/>
                                    <Button Content="🚀 외부 실행" Background="#2D5A27" Foreground="White" BorderThickness="0" FontSize="9.5" Padding="6,2" Cursor="Hand" Click="OpenExternalFile_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="42" Background="#121212" CornerRadius="4" Margin="0,0,0,6" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="WaveformBorder_MouseLeftButtonDown">
                                <Grid>
                                    <Image x:Name="WaveformImage" Stretch="Fill"/>
                                    <Rectangle x:Name="WaveformPlayhead" Width="2" Fill="#FF5555" HorizontalAlignment="Left" Margin="0"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayPauseBtn" Grid.Column="0" Content="▶" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Height="22" Cursor="Hand" Click="PlayPauseMedia_Click"/>
                                <Slider x:Name="MediaSeekSlider" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" Minimum="0" Maximum="100"
                                        IsMoveToPointEnabled="True" Cursor="Hand"
                                        PreviewMouseLeftButtonDown="MediaSeekSlider_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="MediaSeekSlider_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="MediaSeekSlider_PreviewMouseLeftButtonUp"
                                        ValueChanged="MediaSeekSlider_ValueChanged"/>
                                <TextBlock x:Name="MediaTimeText" Grid.Column="2" Text="00:00 / 00:00" Foreground="#AAAAAA" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Paste Clipboard Modified -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{Binding ColorPalette}" Grid.Column="0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding}" Width="22" Height="22" CornerRadius="4" Margin="0,0,4,0" Cursor="Hand" 
                                            BorderBrush="#444444" BorderThickness="1" MouseLeftButtonUp="ColorSwatch_Click" ToolTip="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnThumbFromFile" Content="🖼️" Width="28" Height="26" Margin="0,0,4,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Click="ChangeImageButton_Click" ToolTip="Change Thumbnail from File"/>
                            <Button x:Name="BtnThumbFromClip" Content="📥" Width="28" Height="26" Margin="0,0,4,0" Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand" Click="PasteClipboardThumbnail_Click" ToolTip="Paste Thumbnail from Clipboard"/>
                            <Button x:Name="BtnThumbCopy" Content="📋" Width="28" Height="26" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Cursor="Hand" Click="CopyImageToClipboard_Click" ToolTip="Copy Image to Clipboard"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="AppleMusicSearchBorder" Background="{DynamicResource ThemeCenterBg}" CornerRadius="6" Padding="10" Margin="0,0,0,10" BorderBrush="#007ACC" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Music">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="⚡ 애플뮤직 앨범 자켓 &amp; 정보 자동 검색" Foreground="#569CD6" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <TextBox x:Name="ApiArtistBox" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="5" FontSize="11" Margin="0,0,3,0"/>
                                <TextBox x:Name="ApiTrackBox" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="5" FontSize="11" Margin="3,0,0,0" KeyDown="ApiTrackBox_KeyDown"/>
                            </UniformGrid>
                            <Button x:Name="ApiFetchButton" Content="🔍 애플뮤직 후보 검색" Height="25" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10" Click="FetchCandidates_Click"/>
                            <ListBox x:Name="SearchPopupList" Height="90" Margin="0,6,0,0" Background="{DynamicResource ThemeSidebarBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" 
                                     Visibility="Collapsed" SelectionChanged="SearchPopupList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="3">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplaySub}" Foreground="#888888" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TITLE" Foreground="#888888" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,5" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6"/>

                    <StackPanel Margin="0,0,0,6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Music">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🎼 COMPOSER" Foreground="#569CD6" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Text="🎤 ARTIST / CREATOR" Foreground="#888888" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Creator, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="12" Margin="0,0,0,6"/>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,3,0">
                            <TextBlock Text="🎮 GAME / WORK" Foreground="#888888" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding GameTitle, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Margin="3,0,0,0">
                            <TextBlock Text="🏢 COMPANY" Foreground="#888888" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="12"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="🌐 WEB URL (YouTube / X / Insta / Web)" Foreground="#569CD6" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WebUrl, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11.5"/>
                        <Button Grid.Column="1" Content="🌐 미니 브라우저" Margin="4,0,0,0" Padding="8,4" Background="#2D5A27" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10" Cursor="Hand" Click="OpenMiniBrowser_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="TAGS (슬래시 '/' 입력 시 하위 태그 생성)" Foreground="#888888" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↩️" Width="24" Height="20" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="10" Margin="0,0,4,0" Cursor="Hand" Click="UndoRemovedTag_Click" ToolTip="방금 지운 태그 복원 (Ctrl+Z)"/>
                            <Button Content="⚙️ TAGS" Padding="6,2" Background="{DynamicResource ThemeCardBg}" Foreground="#569CD6" FontWeight="Bold" BorderThickness="0" FontSize="9.5" Cursor="Hand" Click="OpenItemTagManager_Click" ToolTip="현재 파일의 태그 일괄 관리창 열기"/>
                        </StackPanel>
                    </Grid>
                    
                    <ItemsControl ItemsSource="{Binding Labels}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding HexColor}" CornerRadius="3" Padding="5,2" Margin="0,0,4,4" Cursor="Hand" MouseLeftButtonUp="RemoveLabel_Click">
                                    <TextBlock Text="{Binding Name}" Foreground="#1E1E1E" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewLabelNameBox" Grid.Column="0" Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="6,5" FontSize="11.5" KeyDown="NewLabelNameBox_KeyDown"/>
                        <Button x:Name="InspectorColorPickerBtn" Grid.Column="1" Content="#7FB3D5" Background="#7FB3D5" Foreground="#1E1E1E" FontWeight="Bold" BorderThickness="0" Margin="4,0" FontSize="10.5" Cursor="Hand" Click="OpenInspectorColorPicker_Click"/>
                        <Button Grid.Column="2" Content="+ 추가" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" FontSize="10.5" Cursor="Hand" Click="AddLabel_Click"/>
                    </Grid>

                    <TextBlock Text="MEMO / CURATION POINT" Foreground="#888888" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{DynamicResource ThemeCenterBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" 
                             Padding="8" MinHeight="110" Height="Auto" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12"/>

                    <Grid Height="30" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="🔍 Google" Margin="0,0,3,0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold" BorderThickness="0" FontSize="11" Cursor="Hand" Click="SearchWeb_Click"/>
                        <Button Grid.Column="1" Content="▶ YouTube" Margin="3,0,0,0" Background="#C4302B" Foreground="White" FontWeight="SemiBold" BorderThickness="0" FontSize="11" Cursor="Hand" Click="SearchYouTube_Click"/>
                        <Button Grid.Column="2" Content="🎼 VGMdb" Width="105" Margin="6,0,0,0" Background="#2D5A27" Foreground="White" FontWeight="SemiBold" BorderThickness="0" FontSize="11" Cursor="Hand" Click="OpenComposerUrl_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ItemType}" Value="Music">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ItemType}" Value="Audio">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Button x:Name="BtnSaveAll" Content="💾 저장 (자동저장 활성화됨)" Height="32" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="SaveDb_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Sidebar Toggle Button -->
        <Border Grid.Column="2" Width="28" Height="70" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Panel.ZIndex="80">
            <Button x:Name="ToggleLeftSidebarBtn" Content="◀" Opacity="0" Width="24" Height="56" HorizontalAlignment="Left"
                    Background="#AA252526" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1" Cursor="Hand" Click="ToggleLeftSidebar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ToggleLeftSidebarBtn" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ToggleLeftSidebarBtn" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <Border Grid.Column="2" Width="28" Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" Panel.ZIndex="80">
            <Button x:Name="ToggleRightSidebarBtn" Content="◀" Opacity="0" Width="24" Height="56" HorizontalAlignment="Right"
                    Background="#AA252526" Foreground="White" BorderBrush="#55FFFFFF" BorderThickness="1" Cursor="Hand" Click="ToggleRightSidebar_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8,0,0,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ToggleRightSidebarBtn" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.18"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ToggleRightSidebarBtn" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <!-- Tag Manager -->
        <Border x:Name="TagManagerModalOverlay" Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="100"
                Visibility="Collapsed" Opacity="0" Background="#B0000000" MouseDown="TagManagerOverlayBg_MouseDown">
            <Border Width="560" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource ThemeSidebarBg}" BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="12" Padding="22">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock x:Name="LblTmTitle" Text="🏷️ TAGS &amp; FILTER 통합 관리자" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="14" Cursor="Hand" Click="CloseTagManager_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource ThemeCenterBg}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="LblTmGuide" Text="✨ 새 태그 등록 (우측의 색상 버튼을 누르면 10x10 팔레트 &amp; RGB 맵이 열립니다)" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManagerNewTagNameBox" Grid.Column="0" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12.5"/>
                                <Button x:Name="ManagerColorPickerBtn" Grid.Column="1" Content="#7FB3D5" Background="#7FB3D5" Foreground="#1E1E1E" FontWeight="Bold" BorderThickness="0" Margin="6,0" Cursor="Hand" Click="OpenManagerColorPicker_Click"/>
                                <Button x:Name="BtnTmAddTag" Grid.Column="2" Content="+ 태그 등록" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="ManagerAddMasterTag_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnTmDone" DockPanel.Dock="Bottom" Content="완료 및 닫기" Height="34" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,12,0,0" Cursor="Hand" Click="CloseTagManager_Click"/>
                    <Border Background="{DynamicResource ThemeCenterBg}" CornerRadius="8" Padding="8" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1">
                        <ListBox x:Name="ManagerTagListBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextPrimary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{Binding HexColor}" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                        <Button Grid.Column="2" Content="✏️ Rename" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="10.5" Padding="4,3" Margin="2,0" Cursor="Hand" Click="ManagerRenameTag_Click"/>
                                        <Button Grid.Column="3" Content="🎨 Color" Background="{DynamicResource ThemeCardBg}" Foreground="{DynamicResource ThemeTextPrimary}" BorderThickness="0" FontSize="10.5" Padding="4,3" Margin="2,0" Cursor="Hand" Click="ManagerRecolorTag_Click"/>
                                        <Button Grid.Column="4" Content="🗑️ Del" Background="#3A2525" Foreground="#FF6B6B" BorderThickness="0" FontSize="10.5" Padding="4,3" Margin="2,0" Cursor="Hand" Click="ManagerDeleteTag_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <!-- Floating Toast Notification -->
        <Border x:Name="ToastNotification" Grid.Column="0" Grid.ColumnSpan="5" Panel.ZIndex="200"
                Background="#EE007ACC" CornerRadius="20" Padding="22,10" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="20"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText" Text="✨ Save Complete!" Foreground="White" FontSize="13.5" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>